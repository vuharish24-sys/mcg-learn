generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FeedType {
  ARTICLE
  YOUTUBE
  INSTAGRAM_REEL
  PDF
  QUIZ
  CAREER_TIP
  ANNOUNCEMENT
  WEBINAR
  ADVERTISEMENT
  SPONSORED
  INTERNAL_PROMOTION
  JOB_POSTING
  COURSE
  /**
   * A self-paced course actually delivered on the self-hosted Moodle LMS, launched via LTI. Distinct from COURSE (an off-platform, manually-enrolled program).
   */
  MOODLE_COURSE
}

/**
 * Where a feed item is allowed to render. FEED = today's default (main feed).
 */
enum FeedPlacement {
  FEED
  LEARNING_PATH_LIST
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  ADMITTED
  CLOSED
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum ReferralProfileStatus {
  ACTIVE
  INACTIVE
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum ReferralCommissionType {
  FLAT
  PERCENTAGE
  HYBRID
}

enum ReferralCommissionBasis {
  COURSE_FEE
  ADMISSION_FEE
  INSTALLMENT_AMOUNT
  CUSTOM_AMOUNT
}

enum ReferralMilestoneTrigger {
  ADMISSION_CONFIRMED
  REGISTRATION_FEE_PAID
  FIRST_INSTALLMENT_PAID
  SECOND_INSTALLMENT_PAID
  THIRD_INSTALLMENT_PAID
  FULL_FEE_PAID
  MANUAL
  MANUAL_APPROVAL
}

enum ReferralMilestoneCalcType {
  FLAT
  PERCENTAGE
}

enum ReferralCommissionTxnStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum ReferralPaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum ReferralParticipantStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum ReferralMilestoneStatus {
  PENDING
  ACHIEVED
  APPROVED
  PAID
  EXPIRED
  REJECTED
  CANCELLED
}

enum ReferralCampaignAssetType {
  BANNER
  THUMBNAIL
  MOBILE_BANNER
  PROMOTIONAL_POSTER
  STORY_IMAGE
  EMAIL_BANNER
}

enum AdvertisementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum LearningPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LearningPathVisibility {
  PUBLIC
  PRIVATE
}

enum LearningPathDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserLearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/**
 * What a learner receives when they complete a LearningPath.
 */
enum LearningPathRewardType {
  CERTIFICATE
  BADGE
}

enum ContentSourcePlatform {
  YOUTUBE
  INSTAGRAM
  RSS
}

enum ContentSourceItemStatus {
  NEW
  IMPORTED
  DISMISSED
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                         String                          @id @db.Uuid
  email                      String                          @unique
  fullName                   String                          @map("full_name")
  avatarUrl                  String?                         @map("avatar_url")
  phone                      String?
  dateOfBirth                DateTime?                       @map("date_of_birth") @db.Date
  qualification              String?
  fieldOfStudy               String?                         @map("field_of_study")
  yearsExperience            Int?                            @map("years_experience")
  careerGoal                 String?                         @map("career_goal")
  preferredLearningMode      String?                         @map("preferred_learning_mode")
  city                       String?
  country                    String?
  advisingNotes              String?                         @map("advising_notes")
  roleId                     String                          @map("role_id")
  role                       Role                            @relation(fields: [roleId], references: [id])
  isActive                   Boolean                         @default(true) @map("is_active")
  assignedLeads              Lead[]                          @relation("AssignedOfficer")
  trainer                    Trainer?
  referralsMade              Referral[]                      @relation("Referrer")
  referredBy                 Referral?                       @relation("ReferredUser")
  referralProfile            ReferralProfile?
  certificates               Certificate[]
  badges                     Badge[]
  leadNotes                  LeadNote[]
  learningProgress           UserLearningProgress[]
  pathItemCompletions        UserPathItemCompletion[]
  quizAttempts               QuizAttempt[]
  commissionTxnsApproved     ReferralCommissionTransaction[] @relation("CommissionApprovedBy")
  commissionPaymentsPaid     ReferralCommissionPayment[]     @relation("CommissionPaidBy")
  commissionAuditEvents      ReferralCommissionAuditEvent[]  @relation("CommissionAuditActor")
  campaignParticipations     ReferralCampaignParticipant[]
  referralMilestonesExtended ReferralMilestone[]             @relation("ReferralMilestoneExtendedBy")
  campaignTermsAccepted      ReferralCampaignParticipant[]   @relation("CampaignTermsAcceptedBy")
  paymentProofsUploaded      ReferralPaymentAttachment[]     @relation("PaymentProofUploadedBy")
  campaignAuditEvents        ReferralCampaignAuditLog[]      @relation("CampaignAuditActor")
  hostedAppointmentSlots     AppointmentSlot[]               @relation("AppointmentSlotHost")
  appointmentsBooked         Appointment[]                   @relation("AppointmentLearner")
  availabilityRules          AvailabilityRule[]              @relation("AvailabilityRuleHost")
  purchases                  Purchase[]
  classSessionAttendances    ClassSessionAttendance[]
  moduleCompletions          UserModuleCompletion[]
  contentUsageEvents         ContentUsageEvent[]
  courseEnrollments          CourseEnrollment[]
  tutorSessionRequests       TutorSessionRequest[]
  createdAt                  DateTime                        @default(now()) @map("created_at")
  updatedAt                  DateTime                        @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

model FeedCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  feedItems   FeedItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("feed_categories")
}

model FeedItem {
  id                        String                   @id @default(cuid())
  title                     String
  description               String
  thumbnailUrl              String?                  @map("thumbnail_url")
  categoryId                String                   @map("category_id")
  category                  FeedCategory             @relation(fields: [categoryId], references: [id])
  type                      FeedType
  externalUrl               String?                  @map("external_url")
  content                   Json?
  /**
   * JOB_POSTING only: exclusive to this partner's board (+ any partner subscribed to it) instead of MCG's main feed. Null = global, visible everywhere, as with every other feed item.
   */
  postedByPartnerId         String?                  @map("posted_by_partner_id")
  postedByPartner           Partner?                 @relation(fields: [postedByPartnerId], references: [id], onDelete: SetNull)
  previewTitle              String?                  @map("preview_title")
  previewDescription        String?                  @map("preview_description")
  previewImageUrl           String?                  @map("preview_image_url")
  previewSiteName           String?                  @map("preview_site_name")
  previewFetchedAt          DateTime?                @map("preview_fetched_at")
  publishedAt               DateTime?                @map("published_at")
  status                    PublishStatus            @default(DRAFT)
  priority                  Int                      @default(0)
  isFeatured                Boolean                  @default(false) @map("is_featured")
  viewCount                 Int                      @default(0) @map("view_count")
  placements                FeedPlacement[]          @default([FEED])
  /**
   * The topic/prompt an admin gave the AI generator. Null for manually-authored items.
   */
  generationTopic           String?                  @map("generation_topic")
  /**
   * Groups multi-asset content series generated from one master topic. Null for one-off items.
   */
  contentSeriesId           String?                  @map("content_series_id")
  contentSeries             ContentSeries?           @relation(fields: [contentSeriesId], references: [id], onDelete: SetNull)
  /**
   * This asset's specific angle within its content series, e.g. "Day 3 – ICD-10-CM vs CPT".
   */
  seriesAngle               String?                  @map("series_angle")
  advertisement             Advertisement?
  learningPathItems         LearningPathItem[]
  requiredForPaths          LearningPath[]           @relation("RequiredQuizPath")
  pathItemCompletions       UserPathItemCompletion[]
  quizAttempts              QuizAttempt[]
  campaignFeedLinks         CampaignFeedLink[]
  /**
   * COURSE only: benefits (coupons/scholarships/perks) mapped onto this course's variants.
   */
  courseVariantBenefits     CourseVariantBenefit[]
  /**
   * Content-source imports (Admin > Content Sources) that were turned into this feed item.
   */
  sourceItems               ContentSourceItem[]
  /**
   * COURSE only: content-structure modules trainers can be assigned to.
   */
  courseModules             CourseModule[]           @relation("CourseModules")
  trainerProposalsTargeting TrainerProposal[]        @relation("ProposalTargetCourse")
  enrollments               CourseEnrollment[]
  /**
   * MOODLE_COURSE only: the Moodle-side course this FeedItem launches into.
   */
  moodleCourseMapping       MoodleCourseMapping?
  purchases                 Purchase[]
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([type])
  @@index([contentSeriesId])
  @@index([postedByPartnerId])
  @@map("feed_items")
}

/**
 * A master topic's multi-asset content plan (Admin > Feed > Generate Content Series).
 * Each generated FeedItem in the series links back here via contentSeriesId.
 */
model ContentSeries {
  id        String     @id @default(cuid())
  topic     String
  feedItems FeedItem[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("content_series")
}

/**
 * An admin-configured social/blog account to poll for new content
 * (Admin > Content Sources > "Fetch latest"). `handle` means a different
 * thing per platform: YouTube channel ID or @handle, Instagram Business
 * account user ID, or a plain RSS/Atom feed URL. `encryptedApiKey` holds the
 * YouTube API key or Instagram long-lived access token (AES, same as
 * AiProviderConfig) — null for RSS, which needs no credential.
 */
model ContentSource {
  id              String                @id @default(cuid())
  name            String
  platform        ContentSourcePlatform
  handle          String
  encryptedApiKey String?               @map("encrypted_api_key")
  isActive        Boolean               @default(true) @map("is_active")
  lastFetchedAt   DateTime?             @map("last_fetched_at")
  lastError       String?               @map("last_error")
  items           ContentSourceItem[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@map("content_sources")
}

/**
 * One post/video/article discovered from a ContentSource's "Fetch latest"
 * run, staged for admin review before it becomes real feed content — never
 * auto-published. Deduplicated per source by the platform's own item id
 * (`externalId`), so re-fetching only surfaces genuinely new items.
 */
model ContentSourceItem {
  id                 String                  @id @default(cuid())
  sourceId           String                  @map("source_id")
  source             ContentSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId         String                  @map("external_id")
  title              String
  description        String?
  thumbnailUrl       String?                 @map("thumbnail_url")
  externalUrl        String                  @map("external_url")
  publishedAt        DateTime?               @map("published_at")
  status             ContentSourceItemStatus @default(NEW)
  importedFeedItemId String?                 @map("imported_feed_item_id")
  importedFeedItem   FeedItem?               @relation(fields: [importedFeedItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now()) @map("created_at")

  @@unique([sourceId, externalId])
  @@index([status])
  @@index([importedFeedItemId])
  @@map("content_source_items")
}

/**
 * A free time window a Career Officer or Trainer has opened for a 1:1
 * appointment. Available = no linked Appointment yet. Once booked, the slot
 * stays permanently tied to that Appointment (even if later cancelled) —
 * the host opens a fresh slot to offer that time again rather than
 * reopening a used one, keeping booking a single atomic create with no
 * separate "release" step to get wrong.
 */
model AppointmentSlot {
  id          String       @id @default(cuid())
  hostId      String       @map("host_id") @db.Uuid
  host        User         @relation("AppointmentSlotHost", fields: [hostId], references: [id])
  startsAt    DateTime     @map("starts_at")
  endsAt      DateTime     @map("ends_at")
  meetingUrl  String?      @map("meeting_url")
  notes       String?
  appointment Appointment?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([hostId, startsAt])
  @@index([startsAt])
  @@map("appointment_slots")
}

/**
 * A host's standing weekly pattern (e.g. "Mon/Wed/Fri, 4-6pm, 30-min slots").
 * Saving one immediately materializes real AppointmentSlot rows for the next
 * few weeks (see appointmentService.generateSlotsFromRule) — booking itself
 * still only ever operates on real AppointmentSlot rows, so this is purely a
 * bulk slot-creation convenience, not a new runtime concept.
 */
model AvailabilityRule {
  id                  String   @id @default(cuid())
  hostId              String   @map("host_id") @db.Uuid
  host                User     @relation("AvailabilityRuleHost", fields: [hostId], references: [id])
  /**
   * 0 = Sunday .. 6 = Saturday.
   */
  daysOfWeek          Int[]    @map("days_of_week")
  startTime           String   @map("start_time")
  endTime             String   @map("end_time")
  slotDurationMinutes Int      @map("slot_duration_minutes")
  meetingUrl          String?  @map("meeting_url")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("availability_rules")
}

model Appointment {
  id           String            @id @default(cuid())
  slotId       String            @unique @map("slot_id")
  slot         AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  learnerId    String            @map("learner_id") @db.Uuid
  learner      User              @relation("AppointmentLearner", fields: [learnerId], references: [id])
  status       AppointmentStatus @default(BOOKED)
  learnerNotes String?           @map("learner_notes")
  cancelledAt  DateTime?         @map("cancelled_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([learnerId])
  @@map("appointments")
}

model Lead {
  id                String     @id @default(cuid())
  fullName          String     @map("full_name")
  email             String?
  phone             String
  status            LeadStatus @default(NEW)
  assignedOfficerId String?    @map("assigned_officer_id") @db.Uuid
  assignedOfficer   User?      @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  followUpAt        DateTime?  @map("follow_up_at")
  source            String
  notes             LeadNote[]
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([assignedOfficerId])
  @@index([followUpAt])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_notes")
}

model Trainer {
  id              String                  @id @default(cuid())
  userId          String?                 @unique @map("user_id") @db.Uuid
  user            User?                   @relation(fields: [userId], references: [id])
  fullName        String                  @map("full_name")
  email           String                  @unique
  phone           String?
  bio             String?
  experienceYears Int                     @default(0) @map("experience_years")
  specializations String[]
  availability    String
  status          TrainerStatus           @default(PENDING)
  assignments     TrainerAssignment[]
  proposals       TrainerProposal[]
  teachRequests   ModuleTeachRequest[]
  payoutLineItems TrainerPayoutLineItem[]
  sessionRequests TutorSessionRequest[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("trainers")
}

enum TrainerCompensationType {
  HOURLY
  FLAT_PER_SESSION
  FLAT_PER_DELIVERABLE
  PER_STUDENT_USE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum TeachRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassSessionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DISPUTED
}

enum DeliverableStatus {
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum PayoutLineStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutSourceType {
  CLASS_SESSION
  DELIVERABLE
  CONTENT_USAGE
}

/**
 * Marks a student as enrolled in a Course, gating access to that course's
 * modules. Course fees are paid off-platform (variant CTA is an external
 * link or a lead-capture form, not Razorpay), so this is admin-recorded
 * proof of enrollment rather than a Purchase — mirrors PartnerCandidate's
 * `enrolledAt` convention rather than the LearningPath/Bundle purchase flow.
 */
model CourseEnrollment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItemId String   @map("feed_item_id")
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  @@unique([userId, feedItemId])
  @@index([feedItemId])
  @@map("course_enrollments")
}

/**
 * A content-structure unit under a Course FeedItem — separate from the course's pricing `variants`.
 */
model CourseModule {
  id            String                 @id @default(cuid())
  feedItemId    String                 @map("feed_item_id")
  feedItem      FeedItem               @relation("CourseModules", fields: [feedItemId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  /**
   * Recorded video / study material link — completing this is what triggers PER_STUDENT_USE payouts.
   */
  contentUrl    String?                @map("content_url")
  sortOrder     Int                    @default(0) @map("sort_order")
  assignments   TrainerAssignment[]
  teachRequests ModuleTeachRequest[]
  completions   UserModuleCompletion[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([feedItemId])
  @@map("course_modules")
}

/**
 * A trainer's approved role on one module, with its own configurable pay
 * model. A trainer can hold more than one assignment on the same module
 * (e.g. teaching it AND having created its material) — each tracked and
 * compensated independently.
 */
model TrainerAssignment {
  id               String                  @id @default(cuid())
  trainerId        String                  @map("trainer_id")
  trainer          Trainer                 @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courseModuleId   String                  @map("course_module_id")
  courseModule     CourseModule            @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  compensationType TrainerCompensationType @map("compensation_type")
  rateAmountPaise  Int                     @map("rate_amount_paise")
  isActive         Boolean                 @default(true) @map("is_active")
  classSessions    ClassSession[]
  deliverables     Deliverable[]
  usageEvents      ContentUsageEvent[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([trainerId, courseModuleId, compensationType])
  @@index([courseModuleId])
  @@map("trainer_assignments")
}

/**
 * Trainer-initiated: propose a new module (optionally under an existing course) instead of waiting to be assigned.
 */
model TrainerProposal {
  id                       String                  @id @default(cuid())
  trainerId                String                  @map("trainer_id")
  trainer                  Trainer                 @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title                    String
  description              String
  /**
   * Null = proposing content for a brand-new course, admin decides how to place it on approval.
   */
  targetCourseId           String?                 @map("target_course_id")
  targetCourse             FeedItem?               @relation("ProposalTargetCourse", fields: [targetCourseId], references: [id])
  proposedCompensationType TrainerCompensationType @map("proposed_compensation_type")
  proposedRateAmountPaise  Int                     @map("proposed_rate_amount_paise")
  status                   ProposalStatus          @default(PENDING)
  adminNotes               String?                 @map("admin_notes")
  resultingModuleId        String?                 @map("resulting_module_id")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([trainerId])
  @@index([status])
  @@map("trainer_proposals")
}

/**
 * Trainer-initiated: request to teach an already-existing module (admin approves — the module has no separate "creator" concept to route to instead).
 */
model ModuleTeachRequest {
  id                       String                  @id @default(cuid())
  courseModuleId           String                  @map("course_module_id")
  courseModule             CourseModule            @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  trainerId                String                  @map("trainer_id")
  trainer                  Trainer                 @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  proposedCompensationType TrainerCompensationType @map("proposed_compensation_type")
  proposedRateAmountPaise  Int                     @map("proposed_rate_amount_paise")
  status                   TeachRequestStatus      @default(PENDING)
  decidedAt                DateTime?               @map("decided_at")
  createdAt                DateTime                @default(now()) @map("created_at")

  @@index([courseModuleId])
  @@index([trainerId])
  @@map("module_teach_requests")
}

/**
 * One logged teaching occurrence — payable only once at least one attendee confirms.
 */
model ClassSession {
  id                  String                   @id @default(cuid())
  trainerAssignmentId String                   @map("trainer_assignment_id")
  trainerAssignment   TrainerAssignment        @relation(fields: [trainerAssignmentId], references: [id], onDelete: Cascade)
  scheduledAt         DateTime                 @map("scheduled_at")
  durationMinutes     Int                      @map("duration_minutes")
  meetingUrl          String?                  @map("meeting_url")
  notes               String?
  status              ClassSessionStatus       @default(PENDING_CONFIRMATION)
  attendances         ClassSessionAttendance[]
  payoutLineItem      TrainerPayoutLineItem?
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([trainerAssignmentId])
  @@map("class_sessions")
}

model ClassSessionAttendance {
  id             String       @id @default(cuid())
  classSessionId String       @map("class_session_id")
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String       @map("student_id") @db.Uuid
  student        User         @relation(fields: [studentId], references: [id])
  confirmed      Boolean      @default(false)
  confirmedAt    DateTime?    @map("confirmed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([classSessionId, studentId])
  @@map("class_session_attendances")
}

/**
 * A submitted piece of work (content, curriculum design, etc.) for a FLAT_PER_DELIVERABLE assignment.
 */
model Deliverable {
  id                  String                 @id @default(cuid())
  trainerAssignmentId String                 @map("trainer_assignment_id")
  trainerAssignment   TrainerAssignment      @relation(fields: [trainerAssignmentId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  fileUrl             String?                @map("file_url")
  status              DeliverableStatus      @default(SUBMITTED)
  adminNotes          String?                @map("admin_notes")
  payoutLineItem      TrainerPayoutLineItem?
  createdAt           DateTime               @default(now()) @map("created_at")
