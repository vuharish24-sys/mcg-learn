enum PurchasableType {
  LEARNING_PATH
  BUNDLE
  /**
   * A MOODLE_COURSE FeedItem — grants an LTI launch entitlement into the mapped Moodle course.
   */
  MOODLE_COURSE
  /**
   * An on-demand tutor session, priced per-request once a trainer/admin quotes it.
   */
  TUTOR_SESSION
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

/**
 * One checkout attempt against Razorpay. Created PENDING when the order is
 * opened, flipped to PAID once the payment signature is verified (either via
 * the client's post-checkout callback or the Razorpay webhook — whichever
 * arrives; both call the same service method, which is idempotent).
 */
model Purchase {
  id                    String               @id @default(cuid())
  userId                String               @map("user_id") @db.Uuid
  user                  User                 @relation(fields: [userId], references: [id])
  purchasableType       PurchasableType      @map("purchasable_type")
  learningPathId        String?              @map("learning_path_id")
  learningPath          LearningPath?        @relation(fields: [learningPathId], references: [id])
  bundleId              String?              @map("bundle_id")
  bundle                Bundle?              @relation(fields: [bundleId], references: [id])
  /**
   * MOODLE_COURSE only: the FeedItem (type MOODLE_COURSE) being unlocked.
   */
  feedItemId            String?              @map("feed_item_id")
  feedItem              FeedItem?            @relation(fields: [feedItemId], references: [id])
  /**
   * TUTOR_SESSION only: the priced request this payment confirms.
   */
  tutorSessionRequestId String?              @unique @map("tutor_session_request_id")
  tutorSessionRequest   TutorSessionRequest? @relation(fields: [tutorSessionRequestId], references: [id])
  amountPaise           Int                  @map("amount_paise")
  status                PurchaseStatus       @default(PENDING)
  razorpayOrderId       String               @unique @map("razorpay_order_id")
  razorpayPaymentId     String?              @map("razorpay_payment_id")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([learningPathId])
  @@index([bundleId])
  @@index([feedItemId])
  @@map("purchases")
}

/**
 * Links a MOODLE_COURSE FeedItem to the actual course on the self-hosted
 * Moodle instance. The LTI launch endpoint uses this to know which Moodle
 * course to open once a Purchase confirms access.
 */
model MoodleCourseMapping {
  id                   String   @id @default(cuid())
  feedItemId           String   @unique @map("feed_item_id")
  feedItem             FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  moodleCourseId       Int      @map("moodle_course_id")
  /**
   * Moodle's course idnumber/shortname, shown to admins for cross-checking against the Moodle UI — not used programmatically.
   */
  moodleCourseIdNumber String?  @map("moodle_course_id_number")
  /**
   * The exact target_link_uri Moodle's "publish as LTI tool" screen gives for this course — required before launch works, but nullable so the mapping (and its price) can be created before that registration step is done. Must be the bare Tool URL with no query string; Moodle validates it byte-for-byte against the registered redirect URI (confirmed on a real launch attempt).
   */
  targetLinkUri        String?  @map("target_link_uri")
  /**
   * Moodle's "Custom properties" for this published resource (e.g. "id=76205b0e-..."), query-string-shaped — sent as the LTI custom claim, NOT appended to targetLinkUri (Moodle rejects a target_link_uri with a query string).
   */
  ltiCustomParams      String?  @map("lti_custom_params")
  priceInPaise         Int      @map("price_in_paise")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("moodle_course_mappings")
}

enum SessionRequestStatus {
  /**
   * Student submitted a request; awaiting a trainer/admin price quote.
   */
  REQUESTED
  /**
   * Priced — waiting on student payment.
   */
  PRICED
  /**
   * Paid and scheduled.
   */
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

/**
 * A student-initiated request for a paid 1:1 (or small-group) session with a specific trainer, priced per-request rather than a fixed rate.
 */
model TutorSessionRequest {
  id               String               @id @default(cuid())
  studentId        String               @map("student_id") @db.Uuid
  student          User                 @relation(fields: [studentId], references: [id])
  trainerId        String               @map("trainer_id")
  trainer          Trainer              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  topic            String
  preferredAt      DateTime             @map("preferred_at")
  durationMinutes  Int                  @map("duration_minutes")
  status           SessionRequestStatus @default(REQUESTED)
  /**
   * Set by the trainer/admin when quoting — null until status reaches PRICED.
   */
  priceAmountPaise Int?                 @map("price_amount_paise")
  purchase         Purchase?
  scheduledAt      DateTime?            @map("scheduled_at")
  meetingUrl       String?              @map("meeting_url")
  adminNotes       String?              @map("admin_notes")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([trainerId])
  @@index([status])
  @@map("tutor_session_requests")
}

model LearningPathItem {
  id             String       @id @default(cuid())
  learningPathId String       @map("learning_path_id")
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  feedItemId     String       @map("feed_item_id")
  feedItem       FeedItem     @relation(fields: [feedItemId], references: [id])
  sortOrder      Int          @map("sort_order")
  isRequired     Boolean      @default(true) @map("is_required")
  passPercentage Int?         @map("pass_percentage")

  @@unique([learningPathId, feedItemId])
  @@index([learningPathId, sortOrder])
  @@map("learning_path_items")
}

model UserLearningProgress {
  id              String             @id @default(cuid())
