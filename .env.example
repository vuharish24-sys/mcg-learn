# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Use the Supabase transaction pooler for application traffic.
DATABASE_URL="postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"
# Use the direct database connection for migrations.
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# After creating this user in Supabase Auth, seeding promotes it to Admin.
BOOTSTRAP_ADMIN_EMAIL="infomedicalcodingglobal@gmail.com"

# Enable "Confirm email" in Supabase Auth > Providers > Email for verification.
# Self-registration assigns the LEARNER role. Admins change roles in /admin.

# Bearer token for the scheduled expire-referral-milestones and
# publish-scheduled-feed Netlify functions to call their maintenance
# endpoints without an admin session. Generate with: openssl rand -hex 32
CRON_SECRET="generate-a-long-random-string"

# Fallback keys for "Generate with AI" (Admin > Feed) — only used if no provider
# is configured in-app yet (Admin > AI Providers). Once you add a provider
# there, these env vars are ignored in favor of the in-app config. Gemini is
# tried first, Groq is the fallback. Image generation for that feature uses
# Pollinations.ai, which is free and needs no key at all.
GEMINI_API_KEY="your-gemini-api-key"   # https://aistudio.google.com/apikey
GROQ_API_KEY="your-groq-api-key"       # https://console.groq.com/keys

# Master key that encrypts AI provider API keys stored via Admin > AI Providers.
# Required for that admin page to work at all (add/edit/list all fail without
# it). Generate with: openssl rand -hex 32 — losing this key makes any
# previously-saved provider keys unrecoverable, so back it up somewhere safe.
SETTINGS_ENCRYPTION_KEY="generate-a-32-byte-hex-key"

# Appointment notifications — both optional. Without them, booking/cancelling
# an appointment still works; the notification step just silently no-ops.
# Email via Resend: https://resend.com/api-keys — RESEND_FROM_EMAIL must be on
# a domain verified in your Resend account (a sandbox address only works for
# your own account's email in testing).
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="notifications@yourdomain.com"

# WhatsApp via the Meta Graph API — needs a Meta Business App with the
# WhatsApp product added (same underlying Meta Business setup as an
# Instagram content source), a business phone number, and at least one
# message template approved in Meta Business Manager. WHATSAPP_TEMPLATE_NAME
# must exactly match an approved template's name.
WHATSAPP_ACCESS_TOKEN="your-whatsapp-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-business-phone-number-id"
WHATSAPP_TEMPLATE_NAME="appointment_notification"

# Razorpay — powers paid learning paths & bundles. Test-mode keys from
# https://dashboard.razorpay.com/app/keys work fine for development; nothing
# purchasable will check out without real keys configured. KEY_ID is safe to
# expose to the browser (NEXT_PUBLIC_), KEY_SECRET must never be. Set
# WEBHOOK_SECRET to the same value you enter when adding a webhook at
# https://dashboard.razorpay.com/app/webhooks pointed at
# <your-app-url>/api/v1/webhooks/razorpay for the "payment.captured" event —
# this is the reliable source of truth if a learner closes the tab right
# after paying, before the client-side confirmation call completes.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# LTI 1.3 — MCG Learn acts as the "Platform", launching purchased courses on
# the self-hosted Moodle instance (the "Tool"). See docs/MOODLE_SELF_HOSTING.md
# Phase 5. LTI_PLATFORM_ISSUER should be this app's public URL. Generate the
# RSA keypair yourself (never share the private key) with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
# LTI_PLATFORM_KEY_ID can be any short unique string (e.g. a date-based tag).
# MOODLE_LTI_CLIENT_ID / DEPLOYMENT_ID / LOGIN_INIT_URL / REDIRECT_URI all
# come from Moodle's "Publish as LTI tool" registration screen, once done.
LTI_PLATFORM_ISSUER="https://mcg-learn.netlify.app"
LTI_PLATFORM_KEY_ID="2026-09"
LTI_PLATFORM_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LTI_PLATFORM_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# The two URLs below are NOT guesses to reuse — copy them verbatim from
# whatever Moodle's own "Publish as LTI tool" screen displays for this course;
# the exact paths vary by Moodle version and are not worth hardcoding here.
MOODLE_LTI_CLIENT_ID="from-moodle-tool-registration"
MOODLE_LTI_DEPLOYMENT_ID="from-moodle-tool-registration"
MOODLE_LTI_LOGIN_INIT_URL="from-moodle-tool-registration"
MOODLE_LTI_REDIRECT_URI="from-moodle-tool-registration"
